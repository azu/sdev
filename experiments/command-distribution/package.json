{
  "name": "sdev-command-distribution-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:docs": "node prepare.mjs",
    "build:bun": "bun build --compile --minify --bytecode --no-compile-autoload-dotenv --no-compile-autoload-bunfig cli.ts --outfile dist/bun-host",
    "build:scriptc": "scriptc build cli.ts --dynamic --optimization=release --strip -o dist/scriptc-host"
  },
  "dependencies": {"marked": "18.1.0"},
  "devDependencies": {"scriptc": "0.2.8", "@types/node": "26.0.0"}
}
